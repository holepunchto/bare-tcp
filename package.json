{
  "name": "bare-tcp",
  "version": "2.6.1",
  "description": "Native TCP sockets for JavaScript",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./constants": {
      "types": "./lib/constants.d.ts",
      "default": "./lib/constants.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "lib",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-tcp.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-tcp/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-tcp#readme",
  "engines": {
    "bare": ">=1.16.0"
  },
  "dependencies": {
    "bare-dns": "^2.0.4",
    "bare-events": "^2.5.4",
    "bare-stream": "^2.6.4"
  },
  "devDependencies": {
    "bare-os": "^3.9.3",
    "bare-pipe": "^4.2.3",
    "brittle": "^3.19.1",
    "cmake-bare": "^1.1.6",
    "lunte": "^1.8.0",
    "prettier": "^3.4.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "peerDependencies": {
    "bare-pipe": "*"
  },
  "peerDependenciesMeta": {
    "bare-pipe": {
      "optional": true
    }
  }
}
